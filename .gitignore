# ============================================================
# Rust
# ============================================================
/target
**/target
# 编译产物重定向到 C 盘（见 .cargo/config.toml，避开 WDAC 策略）
# 本地 target 目录（若存在）
/target-d/
# workspace 根 Cargo.lock 提交（crates 版本可复现），src-tauri/Cargo.lock 也提交。
# 仅忽略意外产生的 Cargo.lock（如子 crate 内误生成的）。
!/Cargo.lock
!/src-tauri/Cargo.lock

# ============================================================
# Node / 前端
# ============================================================
node_modules/
dist/
*.tsbuildinfo
# TanStack Router 自动生成的路由树（@tanstack/router-plugin 生成，决策 F4）
src/routeTree.gen.ts
# TanStack 插件临时缓存
.tanstack/

# ============================================================
# Tauri
# ============================================================
# tauri-specta / tauri 生成的 schema（构建期重新生成）
/src-tauri/gen/schemas/
# PDFium 预编译动态库：已入库（仅 win-x64 + mac-arm64，共 ~14MB）
# 版本固定 chromium/7881，与 crates/ingest 的 pdfium-render feature 锁定。
# 升级 PDFium 时手动替换二进制 + 同步改 scripts/fetch-pdfium.sh 的 VERSION。
# 注意：仅保留当前 CI 构建的两平台，其他平台（mac-x64/linux-x64）
# 仍被忽略，需时手动 bash scripts/fetch-pdfium.sh <platform> 下载。
/src-tauri/resources/pdfium/mac-x64/
/src-tauri/resources/pdfium/linux-x64/

# ============================================================
# 工具 / 本地状态（不入库）
# ============================================================
# pi workflow 本地运行时状态（workflow-runtime / subagents / workflows）
.pi/
# 探测脚本输出（probe_out.txt 等）
probe_out.txt

# ============================================================
# IDE
# ============================================================
.vscode/
.idea/
*.swp

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# 临时 / 日志
# ============================================================
*.log
